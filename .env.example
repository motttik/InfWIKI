# Gemini API Key (получите на https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Ollama Configuration (для локального LLM)
# Базовый URL Ollama (по умолчанию: http://localhost:11434)
VITE_OLLAMA_BASE_URL=http://localhost:11434
# Модель Ollama для генерации текста (рекомендуется: llama3.2:3b, mistral:7b, qwen2.5:7b)
VITE_OLLAMA_MODEL=llama3.2:3b

# Режим разработки
VITE_APP_MODE=development

# Приложение
VITE_APP_NAME=InfWIKI
VITE_APP_VERSION=2.0.0
